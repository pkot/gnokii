#!/bin/bash

if [ $# -eq 2 ] ; then
	export TESTDIR=$1
	export GNOKII=$2
elif [ $# -eq 0 ] ; then
	export TESTDIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
	export GNOKII="$TESTDIR/../gnokii/gnokii --config $TESTDIR/gnokiirc"
else
	echo "*** Usage: ./testit [Path to test files] [gnokii command] ***"
	exit 1
fi

# The tests exercise charset conversion (SMS/UCS2/vcard), which obviously
# fails under the POSIX/C locale, so set something with a chance to pass.
LC_MESSAGES_BAK=$LC_MESSAGES
LC_CTYPE_BAK=$LC_CTYPE
export LC_MESSAGES=C
export LC_CTYPE=C.UTF-8

RETVAL=0
# For now ignore the tests that are known to fail:
#   - test.2.concatsms
#   - test.17.picture2
#   - test.26.cimelody
#   - test.27.cimelody2
for A in test.00.identify \
	test.01.sms test.29.sendsms test.30.emptysms test.03.ucs2sms test.08.send161sms\
	test.33.send140sms8bit test.34.send141sms8bit \
	test.11.ringtone \
	test.16.imelody \
	test.40.getsms test.41.getsms test.42.getsms test.43.getsms \
	test.01.writephonebook test.02.writephonebook \
	test.03.writephonebook test.04.writephonebook \
	test.05.writephonebook; do
    echo -n "Doing $A... "
    B=`echo $A | sed s/test/out/`
    ( cd $TESTDIR; source $TESTDIR/$A 2>&1 ) | grep -U -v ^GNOKII > $TESTDIR/my$B
    if cmp $TESTDIR/$B $TESTDIR/my$B >/dev/null 2>&1; then
	echo ok
    else
	echo '*** FAILED'
	diff -u $TESTDIR/$B $TESTDIR/my$B
	RETVAL=1
    fi
done

# Restore previous locale setting
export LC_MESSAGES=$LC_MESSAGES_BAK
export LC_CTYPE=$LC_CTYPE_BAK

exit $RETVAL
