#~ "               [-r] [-C n] [-v n] [--long n] [--animation fil;fil;fil;"
#~ "fil]\n"
#~ "               [--concat this;total;serial]\n"
#~ " Ange texten för meddelandet till standard in.\n"
#~ "   destination - telefonnumret dit SMS:et ska skickas\n"
#~ "   --smsc      - telefonnummer till SMS-centret\n"
#~ "   --smscno    - index för SMSC som lagrats i telefonen\n"
#~ "   -r          - kräv leveransrapport\n"
#~ "   -C n        - meddelandeklass; värden [0, 3]\n"
#~ "   -v n        - sätt giltighetsperiod till n minuter\n"
#~ "   --long n    - läs n bytes från inmatning; standard är 160\n"
#~ "\n"

