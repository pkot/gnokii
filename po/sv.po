"                                    den redan finns;\n"
"                                    om flera sms läses in kommer en "
"meddelande-\n"
"                                    identifierare att läggas till i "
"filnamnet\n"
"        --file filnamn\n"
"        -f filnamn                  som ovan men användaren frågas innan\n"
"                                    filen skrivs över\n"
"        --delete\n"
"        -d                          ta bort meddelande efter läsning\n"
"\n"

