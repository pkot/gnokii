#: gnokii/gnokii-phonebook.c:51
#, c-format
msgid ""
" usage: --getphonebook memory start [end]  reads phonebook entries from "
"memory type\n"
"                                         (SM, ME, IN, OU, ...) messages "
"starting\n"
"                                         from location start and ending with "
"end;\n"
"                                         if end option is omitted, just one "
"entry\n"
"                                         is read;\n"
"                                         if 'end' is used all entries are "
"read\n"
"       -r\n"
"       --raw                             output in raw form (comma "
"separated)\n"
"       -v\n"
"       --vcard                           output in vcard format\n"
"       -l\n"
"       --ldif                            output in ldif format\n"
"\n"
msgstr ""
" sposób użycia: --getphonebook typ_pamięci początek [koniec | end] "
"odczytuje\n"
"                wpisy z pamięci typ_pamięci (SM, ME, IN, OU, ...) "
"rozpoczynając\n"
"                od pozycji początek i kończąc na pozycji koniec; jeśli jest\n"
"                użyte słowo end, odczytywane są wszystkie pozycje; jeśli "
"ten\n"
"                argument nie jest podany, odczytywana jest tylko jedna "
"pozycja.\n"
"       -r\n"
"       --raw       wyjście w formacie csv\n"
"       -v\n"
"       --vcard     wyjście w formacie vcard\n"
"       -l\n"
"       --ldif      wyjście w formacje ldif\n"
"\n"

