#: gnokii/gnokii-todo.c:39
#, c-format
msgid ""
"ToDo options:\n"
"          --gettodo start_number [end_number|end] [-v|--vCal]\n"
"          --writetodo vcalendarfile start_number [end_number|end]\n"
"          --deletealltodos\n"
msgstr ""
"Opcje zadań:\n"
"          --gettodo początek [koniec|end] [-v|--vCal]\n"
"          --writetodo plik_vcal początek [koniec|end]\n"
"          --deletealltodos\n"

#: gnokii/gnokii-todo.c:48
#, c-format
msgid ""
"usage: --gettodo start_number [end_number | end] [-v|--vCal]\n"
"       start_number - entry number in the phone todo (numeric)\n"
"       end_number   - until this entry in the phone todo (numeric, "
"optional)\n"
"       end          - the string \"end\" indicates all entries from start to "
"end\n"
"       -v           - output in iCalendar format\n"
"  NOTE: if no end is given, only the start entry is written\n"
msgstr ""
"sposób użycia:\n"
"  --gettodo początek [koniec | end] [-v|--vCal]  odczytuje zadane pozycje\n"
"                                                 z listy zadań w telefonie\n"
"       początek  - numer pierszej pozycji do odczytania na liście zadań w\n"
"                   telefonie (liczba)\n"
"       koniec    - numer ostatniej pozycji do odczytania na liście zadań w\n"
"                   telefonie (liczba, opcjonalnie)\n"
"       end       - napis \"end\" oznacza wszystkie pozycje od początku do "
"końca\n"
"       -v        - wyjście w formacie iCalendar\n"
"  UWAGA: jeśli nie podana jest ostatnia pozycja, odczytywana jest tylko "
"pierwsza\n"

